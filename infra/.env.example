# Copy to infra/.env (ignored by git) and fill in. Load with: set -a; . ./.env; set +a

# Terraform state in Cloudflare R2: an R2 API token's S3 credentials, and the account's endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# Providers.
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=
CLOUDFLARE_API_TOKEN=

# Ids (not secrets).
TF_VAR_atlas_org_id=
TF_VAR_cloudflare_account_id=
TF_VAR_cloudflare_zone_id=
