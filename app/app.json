{
  "expo": {
    "name": "puny-chat",
    "slug": "buddy-chat",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7c7a0fb3-5c1d-48a1-a94b-188d38d19064"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buddychat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "CFBundleLocalizations": ["ja", "ko", "en"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ottuck.buddychat",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF9E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ottuck.buddychat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#16161A"
          }
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "puny-chat uses your photos only when you choose one to send in the chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.365977945909-fnqlp325msddsclmoj3akj99kbk1tebm"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c7a0fb3-5c1d-48a1-a94b-188d38d19064"
      },
      "googleSignIn": {
        "iosClientId": "365977945909-fnqlp325msddsclmoj3akj99kbk1tebm.apps.googleusercontent.com",
        "webClientId": "365977945909-tcsslocg6lp93ns5d1k3cb15ktmks8hg.apps.googleusercontent.com"
      }
    },
    "owner": "vison901"
  }
}
