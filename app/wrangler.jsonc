// The web app as a Cloudflare Worker serving static assets (no script), deployed by CI after
// `pnpm build:web` (docs/spec.md, 인프라). The custom domain comes with the deploy:
// Cloudflare makes its DNS record and certificate.
{
  "name": "puny-chat",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    // Expo writes a page per route (join.html) and +not-found.html, copied to 404.html by
    // scripts/worker-assets.mjs.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Only on puny-chat.com: no workers.dev address (the account has no workers.dev subdomain).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "puny-chat.com", "custom_domain": true }],
}
