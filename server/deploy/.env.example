# Copy to /opt/puny-chat/.env on the instance (chmod 600) and fill in. Never commit the real file.
# Values with line breaks (the VAPID keys) go in double quotes with \n.

PORT=8080
# A fixed, small heap: the instance is shared with other services.
JAVA_TOOL_OPTIONS=-Xmx384m -XX:+UseSerialGC

# From terraform output -raw mongodb_uri (infra/).
SPRING_MONGODB_URI=
SPRING_MONGODB_DATABASE=buddychat
CORS_ALLOWED_ORIGINS=https://puny-chat.com,http://localhost:8081

BUDDYCHAT_PUSH_VAPIDPRIVATEKEY=
BUDDYCHAT_PUSH_VAPIDPUBLICKEY=

# Support mail through the Gmail API (docs/PROJECT.md, 운영).
SUPPORT_EMAIL=
SUPPORT_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
